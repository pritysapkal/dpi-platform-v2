# Copy this file to agent/.env (which is gitignored) and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: override the model. Default is gemini-3.5-flash-lite, which answers reliably on
# the free tier. gemini-3.8-flash can be selected here, but it returned 503/504 errors when
# tested on 2026-11-18.
# GEMINI_MODEL=gemini-3.8-flash
